{
    "name": "github_profile_stats",
    "module": "src/app.ts",
    "type": "module",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "start": "bun run src/app.ts",
        "dev": "bun --watch run src/app.ts",
        "build": "bun build src/app.ts --outfile ./out/app.js --target 'bun'",
        "lint": "eslint ./src",
        "lint:fix": "eslint ./src --fix && prettier --write ./src"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/bun": "latest",
        "eslint": "^9.39.2",
        "globals": "^17.3.0",
        "prettier": "^3.8.1",
        "typescript-eslint": "^8.54.0"
    },
    "peerDependencies": {
        "typescript": "^5"
    }
}
