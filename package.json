{
    "name": "github-profile-stats",
    "module": "src/app.ts",
    "type": "module",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "start": "bun run src/app.ts",
        "dev": "bun --watch run src/app.ts",
        "build": "bun build src/app.ts --outfile ./out/app.js --target 'bun'",
        "lint": "eslint ./src",
        "lint:fix": "eslint ./src --fix && prettier --write ./src"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/bun": "latest",
        "eslint": "^9.39.4",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "typescript-eslint": "^8.60.1"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "zod": "^4.4.3"
    }
}
